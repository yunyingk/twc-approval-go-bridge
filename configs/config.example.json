      "form": {
        "form_content": "[{\"id\":\"details\",\"name\":\"@i18n@details\",\"type\":\"fieldList\",\"required\":true,\"value\":[{\"id\":\"cardholder\",\"name\":\"@i18n@cardholder\",\"type\":\"contact\",\"required\":true,\"value\":{\"ignore\":false,\"multi\":false}},{\"id\":\"card_last4\",\"name\":\"@i18n@card_last4\",\"type\":\"input\",\"required\":true},{\"id\":\"transaction_id\",\"name\":\"@i18n@transaction_id\",\"type\":\"input\",\"required\":true},{\"id\":\"transaction_time\",\"name\":\"@i18n@transaction_time\",\"type\":\"date\",\"required\":true,\"value\":\"YYYY-MM-DD hh:mm\"},{\"id\":\"merchant\",\"name\":\"@i18n@merchant\",\"type\":\"textarea\",\"required\":true},{\"id\":\"transaction_amount\",\"name\":\"@i18n@transaction_amount\",\"type\":\"amount\",\"required\":true,\"value\":\"CNY\",\"option\":{\"currencyRange\":[\"CNY\",\"USD\",\"EUR\",\"MYR\",\"HKD\"],\"keepDecimalPlaces\":2}},{\"id\":\"booked_amount\",\"name\":\"@i18n@booked_amount\",\"type\":\"amount\",\"required\":true,\"value\":\"CNY\",\"option\":{\"currencyRange\":[\"CNY\"],\"keepDecimalPlaces\":2}},{\"id\":\"transaction_region\",\"name\":\"@i18n@transaction_region\",\"type\":\"textarea\",\"required\":true},{\"id\":\"transaction_type\",\"name\":\"@i18n@transaction_type\",\"type\":\"input\",\"required\":true},{\"id\":\"project\",\"name\":\"@i18n@project\",\"type\":\"input\",\"required\":true},{\"id\":\"expense_category\",\"name\":\"@i18n@expense_category\",\"type\":\"input\",\"required\":true},{\"id\":\"invoice_files\",\"name\":\"@i18n@invoice_files\",\"type\":\"attachmentV2\",\"required\":false},{\"id\":\"supplier_allowlist\",\"name\":\"@i18n@supplier_allowlist\",\"type\":\"input\",\"required\":true},{\"id\":\"invoice_duplicate\",\"name\":\"@i18n@invoice_duplicate\",\"type\":\"input\",\"required\":true}],\"option\":{\"inputType\":\"LIST\",\"printType\":\"LIST\"}}]"
      },
